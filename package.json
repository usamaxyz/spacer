{
  "name": "spacer",
  "version": "3.3.24",
  "description": "A powerful realtime client-side validation for input fields based on JQuery, simple dialog API and extra helpful tools for: inputs, form submission, ajax, web navigation, tables and arrays",
  "main": "src/js/spacer.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/usamaxyz/spacer.git"
  },
  "keywords": [
    "validation",
    "jquery-validation",
    "form-validation",
    "form-submission",
    "table",
    "resource-manager",
    "ajax",
    "dialog"
  ],
  "author": "Usama Alshihabi <usamaxyz@gmail.com> (http://www.azarasoft.com)",
  "license": "ISC",
  "scripts": {
    "dev:js": "mix",
    "dev:css": "mix --mix-config=webpack.mix.css.js",
    "prod:js": "mix --production",
    "prod:css": "mix --production --mix-config=webpack.mix.css.js"
  },
  "devDependencies": {
    "laravel-mix": "^6.0.49",
    "resolve-url-loader": "^5.0.0",
    "rtlcss": "^4.3.0",
    "sass": "^1.94.1",
    "sass-loader": "^16.0.6"
  }
}
